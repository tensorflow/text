##############################################################
# Hermetic Python and pip dependencies
##############################################################

PYTHON_VERSIONS = [
    "3.10",
    "3.11",
    "3.12",
    "3.13",
]

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.defaults(
    # The HERMETIC_PYTHON_VERSION environment variable takes precedence if set.
    python_version = "3.11",
    python_version_env = "HERMETIC_PYTHON_VERSION",
)

[python.toolchain(python_version = version) for version in PYTHON_VERSIONS]

python_version_repo = use_repo_rule("//third_party/bazel:python_version.bzl", "python_version_repo")

python_version_repo(
    name = "python_version_repo",
    requirements = {
        version: "//oss_scripts/pip_package:requirements_lock_{}.txt".format(version.replace(".", "_"))
        for version in PYTHON_VERSIONS
    },
)

# Additional targets for the TensorFlow wheel, used to build the custom ops
# against the headers and the framework library of the installed TensorFlow.
# See http://github.com/tensorflow/custom-op.
TF_WHEEL_BUILD_CONTENT = """
load("@rules_cc//cc:cc_library.bzl", "cc_library")

cc_library(
    name = "tf_header_lib",
    hdrs = glob(["site-packages/tensorflow/include/**/*"]),
    includes = [
        # TensorFlow wheels built with Bzlmod keep some third-party headers in
        # directories named after the canonical names of their repositories.
        "site-packages/tensorflow/include/external/protobuf+/third_party/utf8_range",
        "site-packages/tensorflow/include/external/xla++third_party_ext+ml_dtypes_py",
    ],
    strip_include_prefix = "site-packages/tensorflow/include/",
    visibility = ["//visibility:public"],
)

cc_library(
    name = "libtensorflow_framework",
    srcs = select({
        "@platforms//os:macos": ["site-packages/tensorflow/libtensorflow_framework.2.dylib"],
        "//conditions:default": ["site-packages/tensorflow/libtensorflow_framework.so.2"],
    }),
    visibility = ["//visibility:public"],
)
"""

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.whl_mods(
    additive_build_content = """
load("@rules_cc//cc:cc_library.bzl", "cc_library")

cc_library(
    name = "numpy_headers",
    hdrs = glob(["site-packages/numpy/_core/include/**/*.h"]) + glob(["site-packages/numpy/core/include/**/*.h"]),
    includes = ["site-packages/numpy/_core/include", "site-packages/numpy/core/include"],
)
""",
    hub_name = "tf_text_pypi_mods",
    whl_name = "numpy",
)
pip.whl_mods(
    additive_build_content = TF_WHEEL_BUILD_CONTENT,
    hub_name = "tf_text_pypi_mods",
    whl_name = "tensorflow",
)
pip.whl_mods(
    additive_build_content = TF_WHEEL_BUILD_CONTENT,
    hub_name = "tf_text_pypi_mods",
    whl_name = "tf_nightly",
)

[
    pip.parse(
        extra_hub_aliases = {
            "numpy": ["numpy_headers"],
            "tensorflow": [
                "libtensorflow_framework",
                "tf_header_lib",
            ],
            "tf_nightly": [
                "libtensorflow_framework",
                "tf_header_lib",
            ],
        },
        hub_name = "tf_text_pypi",
        python_version = version,
        requirements_lock = "//oss_scripts/pip_package:requirements_lock_{}.txt".format(version.replace(".", "_")),
        whl_modifications = {
            "@tf_text_pypi_mods//:numpy.json": "numpy",
            "@tf_text_pypi_mods//:tensorflow.json": "tensorflow",
            "@tf_text_pypi_mods//:tf_nightly.json": "tf_nightly",
        },
    )
    for version in PYTHON_VERSIONS
]

use_repo(pip, "tf_text_pypi_mods", pypi = "tf_text_pypi")

# Aliases for TensorFlow and tf-keras that point to the nightly packages when
# IS_NIGHTLY=nightly.
py_deps_profile = use_repo_rule("//third_party/bazel:py_deps_profile.bzl", "py_deps_profile")

py_deps_profile(
    name = "release_or_nightly",
    deps_map = {
        "tensorflow": [
            "tf-nightly",
            "tf_header_lib",
            "libtensorflow_framework",
        ],
        "tf-keras": ["tf-keras-nightly"],
    },
    pip_repo_name = "pypi",
    requirements_in = "//oss_scripts/pip_package:requirements.in",
    switch = {
        "IS_NIGHTLY": "nightly",
    },
)
