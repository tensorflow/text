"""Bzlmod module definition for TensorFlow Text."""

module(
    name = "tensorflow_text",
    repo_name = "org_tensorflow_text",
)

##############################################################
# Bazel module dependencies
#
# Keep the versions in sync with the MODULE.bazel file of the TensorFlow commit
# below. Bazel uses the highest version requested by any module, so a lower
# version here has no effect.
##############################################################

bazel_dep(name = "abseil-cpp", version = "20260526.0", repo_name = "com_google_absl")
bazel_dep(name = "apple_support", version = "2.8.0", repo_name = "build_bazel_apple_support")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "googletest", version = "1.18.0", repo_name = "com_google_googletest")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "protobuf", version = "33.6", repo_name = "com_google_protobuf")
bazel_dep(name = "re2", version = "2025-11-05.bcr.1", repo_name = "com_googlesource_code_re2")
bazel_dep(name = "rules_cc", version = "0.2.25")
bazel_dep(name = "rules_license", version = "1.0.0")
bazel_dep(name = "rules_python", version = "2.4.5")
bazel_dep(name = "rules_shell", version = "0.8.0")

# Bazel 9 compatibility: TensorFlow requests versions of these modules that
# use symbols removed in Bazel 9 (for example the global CcInfo). Request newer
# versions to make Bazel select them.
bazel_dep(name = "rules_android", version = "0.7.1", repo_name = None)

##############################################################
# TensorFlow, XLA and rules_ml_toolchain
#
# These modules are not in the Bazel Central Registry. TensorFlow builds XLA
# from its third_party/xla directory, so both modules come from the same
# TensorFlow archive. oss_scripts/prepare_tf_dep.sh replaces the commit with
# the commit of the installed TensorFlow wheel.
#
# Overrides only take effect in the root module, so the overrides from the
# MODULE.bazel file of TensorFlow must be repeated here.
##############################################################

bazel_dep(name = "tensorflow", repo_name = "org_tensorflow")
archive_override(
    module_name = "tensorflow",
    integrity = "sha256-kWhJNXUWnKTtcny9j9XszYpNxbdNx+fQNRCvvMCOyLE=",
    patch_strip = 1,
    patches = [
        # Bazel 9 removed @local_config_platform.
        "//third_party/tensorflow:tensorflow.bazel9.patch",
        "//third_party/tensorflow:tensorflow.shim_sources.patch",
    ],
    strip_prefix = "tensorflow-bb79e82d57d161bb311890d380eb0096668c320a",
    urls = ["https://github.com/tensorflow/tensorflow/archive/bb79e82d57d161bb311890d380eb0096668c320a.tar.gz"],
)

bazel_dep(name = "xla")
archive_override(
    module_name = "xla",
    integrity = "sha256-kWhJNXUWnKTtcny9j9XszYpNxbdNx+fQNRCvvMCOyLE=",
    strip_prefix = "tensorflow-bb79e82d57d161bb311890d380eb0096668c320a/third_party/xla",
    urls = ["https://github.com/tensorflow/tensorflow/archive/bb79e82d57d161bb311890d380eb0096668c320a.tar.gz"],
)

bazel_dep(name = "rules_ml_toolchain")
archive_override(
    module_name = "rules_ml_toolchain",
    integrity = "sha256-7eqXGrr59MzfuhUzAwznbG/NDe51oyNMSlxRQZgSQ64=",
    strip_prefix = "rules_ml_toolchain-9114bb1c3abf4f1a5889ef8fd7ae5a72b1351db3",
    urls = ["https://github.com/google-ml-infra/rules_ml_toolchain/archive/9114bb1c3abf4f1a5889ef8fd7ae5a72b1351db3.tar.gz"],
)

##############################################################
# Hermetic C++ toolchains
##############################################################

register_toolchains("@rules_ml_toolchain//cc:linux_x86_64_linux_x86_64")

register_toolchains("@rules_ml_toolchain//cc:linux_aarch64_linux_aarch64")

##############################################################
# Repositories from TensorFlow module extensions
##############################################################

tf_third_party = use_extension("@org_tensorflow//third_party/extensions:third_party.bzl", "third_party_ext")

# Use the FlatBuffers version of TensorFlow Lite.
use_repo(tf_third_party, "flatbuffers")

##############################################################
